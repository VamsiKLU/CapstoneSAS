# PipelineHub Root Environment Configuration Template
# See springboot-backend/.env.example for backend configuration.

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pipelinehub
DB_USERNAME=root
DB_PASSWORD=

# GitHub OAuth Application
# Authorization callback URL in GitHub must be: http://localhost:8080/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# Admin Seed Credentials
ADMIN_EMAIL=admin@pipelinehub.io
ADMIN_PASSWORD=changeme_before_production

# Service URLs
FRONTEND_URL=http://localhost:5173
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
