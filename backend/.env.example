# PipelineHub Spring Boot Backend -- Environment Variables
# Copy to .env and fill in real values. Never commit real secrets.

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pipelinehub
DB_USERNAME=root
DB_PASSWORD=

# GitHub OAuth App credentials
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL must be: http://localhost:8080/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# Admin credentials (used to seed the admin account on startup)
# These are never returned to the frontend
ADMIN_EMAIL=admin@pipelinehub.io
ADMIN_PASSWORD=changeme_before_production

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Spring Boot server port
SERVER_PORT=8080

# Set to true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false
