# GitHub OAuth App credentials
# Create an OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Admin credentials (used to seed the admin account)
ADMIN_EMAIL=admin@pipelinehub.io
ADMIN_PASSWORD=changeme_before_production

# Session secret -- use a long random string in production
SESSION_SECRET=dev-session-secret-change-in-production

# Frontend URL (for CORS and redirect)
FRONTEND_URL=http://localhost:5173

# Backend port
PORT=3001

# Node environment
NODE_ENV=development
